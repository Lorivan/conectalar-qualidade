diff --git a/tests/test_sprint1_regressao.py b/tests/test_sprint1_regressao.py
new file mode 100644
index 0000000..7778918
--- /dev/null
+++ b/tests/test_sprint1_regressao.py
@@ -0,0 +1,130 @@
+"""Testes de regressão da Sprint 1 (um por defeito corrigido)."""
+from app import db
+from app.models import Ocorrencia, Usuario
+from tests.conftest import csrf_token, login
+
+
+def _criar_ocorrencia(app, usuario_id, status='Pendente'):
+    with app.app_context():
+        o = Ocorrencia(titulo='Vazamento', descricao='Vazamento no corredor', usuario_id=usuario_id, status=status)
+        db.session.add(o)
+        db.session.commit()
+        return o.id
+
+
+def _status(app, oid):
+    with app.app_context():
+        return db.session.get(Ocorrencia, oid).status
+
+
+# D-01 — status só pode mudar por POST com CSRF
+def test_d01_get_nao_altera_status(client, app, sindico, morador):
+    oid = _criar_ocorrencia(app, morador.id)
+    login(client)
+    response = client.get(f'/atualizar-status/{oid}/Resolvido')
+    assert response.status_code == 405
+    assert _status(app, oid) == 'Pendente'
+
+
+def test_d01_post_sem_csrf_e_rejeitado(client, app, sindico, morador):
+    oid = _criar_ocorrencia(app, morador.id)
+    login(client)
+    with client.session_transaction() as sess:
+        sess['_csrf_token'] = 'valido'
+    response = client.post(f'/atualizar-status/{oid}/Resolvido')
+    assert response.status_code == 400
+    assert _status(app, oid) == 'Pendente'
+
+
+def test_d01_post_com_csrf_atualiza_status(client, app, sindico, morador):
+    oid = _criar_ocorrencia(app, morador.id)
+    login(client)
+    response = client.post(f'/atualizar-status/{oid}/Em Andamento', data={'_csrf_token': csrf_token(client)})
+    assert response.status_code == 302
+    assert _status(app, oid) == 'Em Andamento'
+
+
+def test_d01_morador_nao_atualiza_status(client, app, morador):
+    oid = _criar_ocorrencia(app, morador.id)
+    login(client, email='morador@conectalar.com')
+    response = client.post(f'/atualizar-status/{oid}/Resolvido', data={'_csrf_token': csrf_token(client)})
+    assert response.status_code == 403
+    assert _status(app, oid) == 'Pendente'
+
+
+def test_d01_dashboard_renderiza_formulario_post_para_sindico(client, app, sindico, morador):
+    _criar_ocorrencia(app, morador.id)
+    login(client)
+    html = client.get('/dashboard').get_data(as_text=True)
+    assert 'method="post" action="/atualizar-status/' in html
+    assert 'name="_csrf_token"' in html
+
+
+# D-03 — feedback para status inválido / ocorrência inexistente
+def test_d03_status_invalido_informa_usuario(client, app, sindico, morador):
+    oid = _criar_ocorrencia(app, morador.id)
+    login(client)
+    response = client.post(f'/atualizar-status/{oid}/Inexistente',
+                           data={'_csrf_token': csrf_token(client)}, follow_redirects=True)
+    assert 'status inválido'.encode() in response.data
+    assert _status(app, oid) == 'Pendente'
+
+
+def test_d03_ocorrencia_inexistente_informa_usuario(client, sindico):
+    login(client)
+    response = client.post('/atualizar-status/9999/Resolvido',
+                           data={'_csrf_token': csrf_token(client)}, follow_redirects=True)
+    assert 'ocorrência inexistente'.encode() in response.data
+
+
+# D-02 — login insensível a caixa/espacos no e-mail
+def test_d02_login_ignora_caixa_e_espacos_do_email(client, sindico):
+    response = login(client, email='  Sindico@ConectaLar.COM ')
+    assert response.status_code == 302
+    assert '/dashboard' in response.headers['Location']
+
+
+# D-04 — cookies de sessão
+def test_d04_cookie_de_sessao_configurado(app):
+    assert app.config['SESSION_COOKIE_HTTPONLY'] is True
+    assert app.config['SESSION_COOKIE_SAMESITE'] == 'Lax'
+
+
+def test_d04_cookie_secure_em_producao(monkeypatch):
+    import importlib
+
+    import config
+    monkeypatch.setenv('APP_ENV', 'production')
+    monkeypatch.setenv('SECRET_KEY', 'x')
+    recarregado = importlib.reload(config)
+    try:
+        assert recarregado.Config.SESSION_COOKIE_SECURE is True
+    finally:
+        monkeypatch.setenv('APP_ENV', 'testing')
+        importlib.reload(config)
+
+
+# Cobertura de /cadastro (autorização + duplicidade) — lacuna da linha de base
+def test_cadastro_exige_sindico(client, morador):
+    login(client, email='morador@conectalar.com')
+    assert client.get('/cadastro').status_code == 403
+
+
+def test_cadastro_email_duplicado_e_rejeitado(client, app, sindico):
+    login(client)
+    dados = {'nome': 'Novo Morador', 'email': 'sindico@conectalar.com', 'senha': '123456',
+             'unidade': 'Casa 5', 'tipo': 'morador', '_csrf_token': csrf_token(client)}
+    response = client.post('/cadastro', data=dados)
+    assert response.status_code == 400
+    with app.app_context():
+        assert Usuario.query.filter_by(email='sindico@conectalar.com').count() == 1
+
+
+def test_cadastro_valido_cria_usuario_com_hash(client, app, sindico):
+    login(client)
+    dados = {'nome': 'Novo Morador', 'email': 'NOVO@x.com', 'senha': '123456',
+             'unidade': 'Casa 5', 'tipo': 'morador', '_csrf_token': csrf_token(client)}
+    assert client.post('/cadastro', data=dados).status_code == 302
+    with app.app_context():
+        u = Usuario.query.filter_by(email='novo@x.com').first()
+        assert u is not None and u.senha != '123456'
