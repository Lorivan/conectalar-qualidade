@@ -0,0 +1,16 @@
+"""Apaga TODOS os usuários. Uso exclusivo em desenvolvimento local."""
+import sys
+
+from app import app, db
+from app.models import Usuario
+
+if app.config.get('IS_PRODUCTION'):
+    sys.exit('Recusado: operação proibida com APP_ENV=production.')
+
+if input('Isto apagará TODOS os usuários. Digite APAGAR para confirmar: ') != 'APAGAR':
+    sys.exit('Operação cancelada.')
+
+with app.app_context():
+    Usuario.query.delete()
+    db.session.commit()
+    print('Usuários apagados!')
